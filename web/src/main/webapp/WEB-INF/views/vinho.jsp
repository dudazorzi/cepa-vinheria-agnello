<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="br.com.cepa.model.Wine,br.com.cepa.web.Html" %><% Wine wine = (Wine)request.getAttribute("wine"); %>
<div class="container breadcrumbs"><a href="<%= request.getContextPath() %>/inicio">Início</a> / <a href="<%= request.getContextPath() %>/catalogo">Catálogo</a> / <span><%= Html.escape(wine.name()) %></span></div>
<section class="product-layout container"><div class="product-visual <%= Html.escape(wine.color()) %>"><span class="bottle bottle-large"><span class="bottle-neck"></span><span class="bottle-body"><span class="bottle-label"></span></span></span></div><div class="product-copy"><span class="eyebrow"><%= Html.escape(wine.type() + " · " + wine.style()) %></span><h1><%= Html.escape(wine.name()) %></h1><p class="region">◈ <%= Html.escape(wine.region()) %></p><p class="product-description"><%= Html.escape(wine.description()) %></p><div class="product-facts"><div><span>HARMONIZA COM</span><strong><%= Html.escape(wine.pairing()) %></strong></div><div><span>ESTILO</span><strong><%= Html.escape(wine.style()) %></strong></div><div><span>DISPONIBILIDADE</span><strong><%= wine.stock() > 0 ? wine.stock() + " garrafas" : "Indisponível" %></strong></div></div><div class="purchase-box"><div><small>Preço por garrafa</small><strong><%= wine.formattedPrice() %></strong></div><form action="<%= request.getContextPath() %>/carrinho" method="post"><input type="hidden" name="acao" value="adicionar"><input type="hidden" name="id" value="<%= Html.escape(wine.id()) %>"><button class="button primary" type="submit" <%= wine.stock() < 1 ? "disabled" : "" %>>Adicionar ao carrinho ↗</button></form></div><p class="prototype-note">Compra demonstrativa: este projeto não processa pagamentos ou entregas.</p></div></section>
