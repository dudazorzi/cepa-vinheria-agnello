<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,br.com.cepa.model.Wine,br.com.cepa.web.Html" %><% List<Wine> wines = (List<Wine>)request.getAttribute("historyWines"); %>
<section class="page-heading container"><span class="eyebrow">SEU ESPAÇO</span><h1>Minha Adega</h1><p>As escolhas registradas nesta sessão ficam reunidas aqui.</p></section><div class="container adega-banner"><div class="avatar">MC</div><div><strong>Visitante CEPA</strong><small>Histórico demonstrativo desta sessão</small></div><div class="adega-count"><strong><%= wines.size() %></strong><small>rótulos</small></div><a class="button outline" href="<%= request.getContextPath() %>/quiz">Refazer quiz</a></div><section class="container history-section"><h2>Histórico de escolhas</h2><% if (wines.isEmpty()) { %><div class="empty-state"><h3>Ainda não há vinhos na sua adega</h3><p>Adicione rótulos ao carrinho e registre um pedido demonstrativo para vê-los aqui.</p><a class="button primary" href="<%= request.getContextPath() %>/catalogo">Explorar catálogo</a></div><% } else { %><div class="wine-grid"><% for (Wine wine : wines) { %><article class="wine-card"><a class="wine-visual <%= Html.escape(wine.color()) %>" href="<%= request.getContextPath() %>/vinho?id=<%= Html.escape(wine.id()) %>"><span class="bottle"><span class="bottle-neck"></span><span class="bottle-body"><span class="bottle-label"></span></span></span></a><div class="wine-info"><span class="wine-type">ESCOLHIDO POR VOCÊ</span><h3><a href="<%= request.getContextPath() %>/vinho?id=<%= Html.escape(wine.id()) %>"><%= Html.escape(wine.name()) %></a></h3><p><%= Html.escape(wine.region()) %></p></div></article><% } %></div><% } %></section>
