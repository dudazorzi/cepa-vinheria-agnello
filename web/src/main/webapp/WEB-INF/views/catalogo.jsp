<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,br.com.cepa.model.Wine,br.com.cepa.web.Html" %>
<% List<Wine> wines = (List<Wine>)request.getAttribute("wines"); String type = (String)request.getAttribute("type"); String search = (String)request.getAttribute("search"); String style = (String)request.getAttribute("style"); %>
<section class="page-heading container"><span class="eyebrow">A ESCOLHA COMEÇA AQUI</span><h1>Encontre seu próximo vinho</h1><p>Use seu paladar, uma ocasião ou uma curiosidade para começar.</p></section>
<div class="catalog-layout container"><aside class="filter-panel"><form action="<%= request.getContextPath() %>/catalogo" method="get"><h2>☷ Filtrar</h2><label for="busca">Buscar vinho</label><input id="busca" name="busca" type="search" value="<%= Html.escape(search) %>" placeholder="Rótulo, região ou prato"><label for="tipo">Tipo</label><select id="tipo" name="tipo"><option value="">Todos</option><% for (String option : List.of("Tinto","Branco","Espumante","Rosé")) { %><option value="<%= option %>" <%= option.equals(type) ? "selected" : "" %>><%= option %></option><% } %></select><label for="estilo">Estilo</label><select id="estilo" name="estilo"><option value="">Todos</option><% for (String option : List.of("Leve","Encorpado","Suave")) { %><option value="<%= option %>" <%= option.equals(style) ? "selected" : "" %>><%= option %></option><% } %></select><button class="button primary full" type="submit">Aplicar filtros</button><a class="clear-link" href="<%= request.getContextPath() %>/catalogo">Limpar filtros</a></form><div class="filter-tip"><strong>Não sabe por onde começar?</strong><p>O quiz ajuda a identificar o estilo que combina com você.</p><a href="<%= request.getContextPath() %>/quiz">Fazer quiz →</a></div></aside><section class="catalog-content"><div class="catalog-toolbar"><p><strong><%= wines.size() %></strong> vinhos encontrados<% if (!style.isBlank()) { %> · perfil <strong><%= Html.escape(style) %></strong><% } %></p><span class="data-mode"><%= Html.escape(request.getAttribute("mode")) %></span></div><% if (wines.isEmpty()) { %><div class="empty-state"><h2>Nenhum vinho encontrado</h2><p>Tente outros filtros ou explore o catálogo completo.</p><a class="button outline" href="<%= request.getContextPath() %>/catalogo">Ver todos</a></div><% } else { %><div class="wine-grid"><% for (Wine wine : wines) { %><article class="wine-card"><a class="wine-visual <%= Html.escape(wine.color()) %>" href="<%= request.getContextPath() %>/vinho?id=<%= Html.escape(wine.id()) %>" aria-label="Ver <%= Html.escape(wine.name()) %>"><span class="wine-shine"></span><span class="bottle"><span class="bottle-neck"></span><span class="bottle-body"><span class="bottle-label"></span></span></span></a><div class="wine-info"><span class="wine-type"><%= Html.escape(wine.type() + " · " + wine.style()) %></span><h3><a href="<%= request.getContextPath() %>/vinho?id=<%= Html.escape(wine.id()) %>"><%= Html.escape(wine.name()) %></a></h3><p><%= Html.escape(wine.region()) %></p><span class="pairing">Combina com <%= Html.escape(wine.pairing().toLowerCase()) %></span><div class="wine-bottom"><strong><%= wine.formattedPrice() %></strong><span class="stock <%= wine.stock() < 8 ? "low" : "" %>"><%= wine.stock() > 0 ? wine.stock() + " em estoque" : "Indisponível" %></span></div></div></article><% } %></div><% } %></section></div>
