<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,br.com.cepa.web.CepaServlet.CartLine,br.com.cepa.web.Html" %><% List<CartLine> lines = (List<CartLine>)request.getAttribute("lines"); %>
<section class="page-heading container"><span class="eyebrow">SUAS ESCOLHAS</span><h1>Meu carrinho</h1><p>Revise os vinhos antes de registrar um pedido demonstrativo.</p></section><div class="container cart-layout"><div class="cart-items"><% if (lines.isEmpty()) { %><div class="empty-state"><h2>Seu carrinho está vazio</h2><p>O próximo vinho favorito pode estar no catálogo.</p><a class="button primary" href="<%= request.getContextPath() %>/catalogo">Explorar vinhos</a></div><% } else { for (CartLine line : lines) { %><article class="cart-item"><div class="cart-thumb <%= Html.escape(line.wine().color()) %>"><span class="bottle"><span class="bottle-neck"></span><span class="bottle-body"><span class="bottle-label"></span></span></span></div><div><span class="wine-type"><%= Html.escape(line.wine().type()) %></span><h2><a href="<%= request.getContextPath() %>/vinho?id=<%= Html.escape(line.wine().id()) %>"><%= Html.escape(line.wine().name()) %></a></h2><p>Quantidade: <%= line.quantity() %></p><form action="<%= request.getContextPath() %>/carrinho" method="post"><input type="hidden" name="acao" value="remover"><input type="hidden" name="id" value="<%= Html.escape(line.wine().id()) %>"><button class="text-button" type="submit">Remover</button></form></div><strong><%= line.formattedSubtotal() %></strong></article><% } } %></div><aside class="order-summary"><h2>Resumo</h2><div><span>Itens</span><span><%= request.getAttribute("cartCount") %></span></div><div class="summary-total"><span>Total</span><strong><%= request.getAttribute("total") %></strong></div><% if (!lines.isEmpty()) { %><form action="<%= request.getContextPath() %>/carrinho" method="post"><input type="hidden" name="acao" value="finalizar"><button class="button primary full" type="submit">Registrar pedido demonstrativo</button></form><% } %><p>Nenhum pagamento será realizado.</p></aside></div>
